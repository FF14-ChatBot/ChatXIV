# PostHog (optional). When set, frontend sends high-level events (e.g. pageview); no PII or message content.
# Per https://posthog.com/docs/libraries/react — use VITE_PUBLIC_ prefix for Vite.
# VITE_PUBLIC_POSTHOG_TOKEN=
# VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ChatXIV backend URL — where the frontend sends API requests (chatxivApiRequest), NOT the frontend dev server.
# Leave unset for same-origin (e.g. when front and backend share a host).
# Local dev: use the URL your backend listens on (backend default port 3000, overridable via PORT in backend .env).
# Production (chatxiv.com):
# VITE_CHATXIV_BACKEND_URL=https://api.chatxiv.com
# Local dev:
# VITE_CHATXIV_BACKEND_URL=http://localhost:3000

# Pre-release: in production builds only, redirect all routes to /unavailable when set to "true".
# VITE_APP_PRELAUNCH_REDIRECT=true

# Google AdSense (optional). Set client + at least one slot so display units render; otherwise the dashed placeholder remains.
# Create ad units in AdSense → Ads → By ad unit; use the numeric slot id for VITE_PUBLIC_ADSENSE_SLOT (or per-placement vars below).
# VITE_PUBLIC_ADSENSE_CLIENT=ca-pub-0000000000000000
# VITE_PUBLIC_ADSENSE_SLOT=
# VITE_PUBLIC_ADSENSE_SLOT_WELCOME=
# VITE_PUBLIC_ADSENSE_SLOT_MESSAGES=
