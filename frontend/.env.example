# PostHog (optional). When set, frontend sends high-level events (e.g. pageview); no PII or message content.
# Per https://posthog.com/docs/libraries/react — use VITE_PUBLIC_ prefix for Vite.
# VITE_PUBLIC_POSTHOG_TOKEN=
# VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ChatXIV API base for chatxivApiRequest (not the Vite dev server). Unset = same origin; Vite proxies /v1, /health, /docs → localhost:3000.
# Tunnel + Cloudflare Access on the API can return login HTML instead of JSON (fix Access or use local API for dev).
# VITE_CHATXIV_BACKEND_URL=https://api.chatxiv.com
# VITE_CHATXIV_BACKEND_URL=http://localhost:3000

# Boot reads isProductLive via GET /v1/flags/isProductLive; failure or disabled flag sends / → /unavailable.

# Google AdSense (optional): set publisher + slots in frontend/src/lib/adsense/adsenseConfig.ts
# (ADSENSE_PUBLISHER_CLIENT, SHARED_DISPLAY_SLOT). When configured, Vite injects
# <meta name="google-adsense-account" …> into index.html for crawlers (site verification).
