# ChatXIV frontend — copy to .env (gitignored). Only VITE_* is exposed to the client.

# API origin. Unset = same-origin; local dev often uses Vite proxy to the backend.
# VITE_CHATXIV_BACKEND_URL=http://localhost:3000

# Grafana Faro frontend observability (optional). Omit to disable.
# VITE_GRAFANA_FARO_URL=https://faro-collector-prod-us-east-3.grafana.net/collect/<your-app-key>

# App version injected at build time (optional, defaults to 0.0.0)
# VITE_APP_VERSION=0.1.0

# PostHog (optional)
# VITE_PUBLIC_POSTHOG_TOKEN=
# VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
