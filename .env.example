# Repo root: copy to `.env` (gitignored). Do not commit real secrets.
#
# === GitHub webhook (`npm run webhook:listen`, `node --env-file=.env`) ===
# Signing secret must match GitHub → Repository → Webhooks (X-Hub-Signature-256).
GITHUB_WEBHOOK_SECRET=generate-a-long-random-string

# Optional: only accept pushes for this repo (owner/name).
# GITHUB_REPO_FULL_NAME=FF14-ChatBot/ChatXIV

# Optional listener tuning (defaults shown)
# PORT=8790
# WEBHOOK_PATH=/webhooks/github
# WEBHOOK_MAX_BODY_BYTES=1048576
