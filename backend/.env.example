# chatXIV backend — environment variables
# Copy to .env and fill in real values.  .env is gitignored; never commit secrets.
#
# Production (Render): set these in the dashboard under Environment → Environment Variables.

# ── Secrets (required per feature) ────────────────────────────────────────────
# Anthropic API key — required for chat routes; obtain from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
# Admin API key — required for admin routes (feature flags, etc.); generate any random string
# ADMIN_API_KEY=changeme-generate-a-random-secret

# ── Optional (sensible defaults) ──────────────────────────────────────────────
# CORS_ORIGIN — comma-separated; if unset, built-in defaults (prod + localhost:5173) apply
# CORS_ORIGIN=http://localhost:5173
NODE_ENV=development
PORT=3000
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# DATA_DIR=./data
# LOG_LEVEL=info
# DEBUG_MODE=false
# MAX_BODY_SIZE_KB=50
# REQUEST_TIMEOUT_MS=30000
# RATE_LIMIT_CAPACITY=10
# RATE_LIMIT_REFILL_PER_MIN=2
