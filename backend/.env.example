# chatXIV backend — environment variables
# Copy to .env and fill in real values.  .env is gitignored; never commit secrets.
#
# Production (Render): set these in the dashboard under Environment → Environment Variables.

# ── Secrets (required per feature) ────────────────────────────────────────────
# Anthropic API key — required for chat routes; obtain from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ── Optional (sensible defaults) ──────────────────────────────────────────────
# CORS_ORIGIN — comma-separated; if unset, see backend/src/lib/config/cors.ts. If set, replaces that list entirely.
# CORS_ORIGIN=https://www.chatxiv.com,https://chatxiv.com
NODE_ENV=development
PORT=3000
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# DATA_DIR=./data
#
# Application persistence (metrics, usage analytics, feature flags, etc.) — SQLite.
# File: {DATA_DIR}/app.db (DATA_DIR defaults to ./data under process.cwd()).
# LOG_LEVEL=info
# DEBUG_MODE=false
# MAX_BODY_SIZE_KB=50
# REQUEST_TIMEOUT_MS=30000
# RATE_LIMIT_CAPACITY=20
# RATE_LIMIT_REFILL_PER_MIN=4
#
# Cloudflare Turnstile (optional bot check for chat / sensitive POST). https://developers.cloudflare.com/turnstile/
# TURNSTILE_SECRET_KEY=

# ── OIDC / Auth (optional — app works without login) ────────────────
# PKCE + signed state are carried in the OAuth `state` param (no fragile cross-host cookie).
# You can open /v1/auth/login on your tunnel API while OIDC_REDIRECT_URI points at localhost (or the reverse)
# as long as that URI is registered with your IdP.
# All five vars below must be set together to enable OIDC login.
#
# OIDC provider URL (e.g. https://accounts.google.com, https://your-tenant.auth0.com)
# OIDC_ISSUER=https://accounts.google.com
# OAuth client ID from provider dashboard
# OIDC_CLIENT_ID=your-client-id.apps.googleusercontent.com
# OAuth client secret from provider dashboard
# OIDC_CLIENT_SECRET=your-client-secret
# Callback URL — must match what you registered with the provider exactly
# OIDC_REDIRECT_URI=http://localhost:3000/v1/auth/callback
# SPA URL — browser goes here after login (dev: Vite; prod: your site). Not the API host.
# NOTE: The session cookie is scoped to THIS server's domain. For the frontend to include
# it in API calls, VITE_CHATXIV_BACKEND_URL (in frontend/.env) must target the same host
# that sets the cookie. For local dev: use http://localhost:3000 (or leave empty to use
# Vite's /v1 proxy). Using a Cloudflare Tunnel URL here while the cookie is on localhost
# will cause the cookie to not be sent — different origins.
# FRONTEND_ORIGIN=http://localhost:5173
# Cookie signing secret — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# SESSION_SECRET=changeme-generate-a-random-secret
#
# First admin: set this to your OIDC sub (shown in logs on first login), then remove after setup.
# BOOTSTRAP_ADMIN_SUBS=
