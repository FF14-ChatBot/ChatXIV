# ChatXIV backend — copy to .env (gitignored). Set real values on the host or in a secret store.
# Variable names and defaults: backend/src/lib/config/env.ts
# Paths, JSON body limit, request timeout, and rate limits are code constants (backend/src/lib/config/constants.ts), not env.

# Required for chat routes
ANTHROPIC_API_KEY=sk-ant-...

# development | beta | production (see getNodeEnv() in backend/src/lib/config/env.ts)
NODE_ENV=development
PORT=3000

# Optional — comma-separated browser origins; if unset, see backend/src/lib/config/cors.ts
# CORS_ORIGIN=https://www.chatxiv.com,https://chatxiv.com

# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# LOG_LEVEL=info
# Optional Loki push — set all three or none (see backend README).
# LOKI_HOST=https://logs-prod-NNN.grafana.net
# LOKI_USER_ID=
# LOKI_PASSWORD=
# DEBUG_MODE=false
# TURNSTILE_SECRET_KEY=

# OIDC login — set all of these together or leave all unset (see backend README)
# OIDC_ISSUER=https://accounts.google.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=http://localhost:3000/v1/auth/callback
# FRONTEND_ORIGIN=http://localhost:5173
# SESSION_SECRET=
# BOOTSTRAP_ADMIN_SUBS=

# Cache — local dev uses Redis for parity with deployed envs (see backend/README.md)
# Start Redis: docker run --rm -p 6379:6379 redis:7-alpine
CACHE_BACKEND=redis
REDIS_URL=redis://localhost:6379
# When false, the process still starts if Redis is down; /health/cache returns 503 until healthy
REDIS_REQUIRED=false

# MediaWiki client (ConsoleGamesWiki, Fandom FFXIV) — see backend/README.md
# Required by wiki policy; unset falls back to a placeholder that wikis may block or rate-limit.
# MEDIAWIKI_USER_AGENT=ChatXIV/1.0 (contact@example.com)
# MEDIAWIKI_TIMEOUT_MS=5000
# Requests per second, applied per wiki (not global)
# MEDIAWIKI_RATE_LIMIT_PER_SECOND=1
# Override default base URLs (testing or alternate endpoints)
# MEDIAWIKI_CGW_URL=https://ffxiv.consolegameswiki.com/mediawiki/api.php
# MEDIAWIKI_FANDOM_FFXIV_URL=https://finalfantasy.fandom.com/api.php
